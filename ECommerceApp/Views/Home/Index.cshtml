@{
    ViewData["Title"] = "Dashboard";
}

<h2 class="mb-4"><i class="bi bi-speedometer2 me-2"></i>Dashboard</h2>

<!-- Stats Cards -->
<div class="row g-4 mb-5">
    <div class="col-md-4">
        <div class="card text-white bg-primary">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="card-title mb-0">Total Products</h6>
                    <h2 class="mt-1 mb-0">@ViewBag.TotalProducts</h2>
                </div>
                <i class="bi bi-box-seam" style="font-size:2.5rem; opacity:.6"></i>
            </div>
            <div class="card-footer bg-transparent border-0">
                <a href="/Products" class="text-white text-decoration-none small">View All <i class="bi bi-arrow-right"></i></a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-white bg-success">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="card-title mb-0">Categories</h6>
                    <h2 class="mt-1 mb-0">@ViewBag.TotalCategories</h2>
                </div>
                <i class="bi bi-tags" style="font-size:2.5rem; opacity:.6"></i>
            </div>
            <div class="card-footer bg-transparent border-0">
                <a href="/Categories" class="text-white text-decoration-none small">Manage <i class="bi bi-arrow-right"></i></a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-white bg-warning">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="card-title mb-0">Total Stock</h6>
                    <h2 class="mt-1 mb-0">@ViewBag.TotalStock</h2>
                </div>
                <i class="bi bi-archive" style="font-size:2.5rem; opacity:.6"></i>
            </div>
            <div class="card-footer bg-transparent border-0">
                <span class="text-white small">Units in inventory</span>
            </div>
        </div>
    </div>
</div>

<!-- Recent Products -->
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-clock-history me-2"></i>Recently Added Products</h5>
        <a asp-controller="Products" asp-action="Create" class="btn btn-sm btn-primary">
            <i class="bi bi-plus-circle me-1"></i>Add Product
        </a>
    </div>
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Product Name</th>
                    <th>Category</th>
                    <th>Price (₹)</th>
                    <th>Stock</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in ViewBag.RecentProducts)
                {
                    <tr>
                        <td>@product.Name</td>
                        <td><span class="badge bg-secondary">@product.Category?.Name</span></td>
                        <td>₹@product.Price.ToString("N2")</td>
                        <td>
                            @if (product.StockQuantity < 5)
                            {
                                <span class="badge bg-danger">@product.StockQuantity Low</span>
                            }
                            else
                            {
                                <span>@product.StockQuantity</span>
                            }
                        </td>
                        <td>
                            <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id"
                               class="btn btn-sm btn-outline-info">
                                <i class="bi bi-eye"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
