@{
    ViewData["Title"] = "Dashboard";
}

<div class="mb-5">
    <h2 class="display-6 fw-bold mb-1">Welcome back, Admin</h2>
    <p class="text-muted">Here's what's happening with your store today.</p>
</div>

<!-- Stats Cards -->
<div class="row g-4 mb-5">
    <div class="col-md-4">
        <div class="card border-0">
            <div class="card-body p-4">
                <div class="stat-icon icon-blue">
                    <i class="bi bi-box-seam"></i>
                </div>
                <h6 class="text-secondary fw-semibold text-uppercase small mb-1">Total Products</h6>
                <h2 class="fw-bold mb-0">@ViewBag.TotalProducts</h2>
                <div class="mt-3 pt-3 border-top">
                    <a href="/Products" class="text-primary text-decoration-none small fw-semibold">
                        View Product Inventory <i class="bi bi-chevron-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0">
            <div class="card-body p-4">
                <div class="stat-icon icon-green">
                    <i class="bi bi-tags"></i>
                </div>
                <h6 class="text-secondary fw-semibold text-uppercase small mb-1">Product Categories</h6>
                <h2 class="fw-bold mb-0">@ViewBag.TotalCategories</h2>
                <div class="mt-3 pt-3 border-top">
                    <a href="/Categories" class="text-success text-decoration-none small fw-semibold">
                        Manage Categories <i class="bi bi-chevron-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0">
            <div class="card-body p-4">
                <div class="stat-icon icon-orange">
                    <i class="bi bi-stack"></i>
                </div>
                <h6 class="text-secondary fw-semibold text-uppercase small mb-1">Inventory Level</h6>
                <h2 class="fw-bold mb-0">@ViewBag.TotalStock <small class="text-muted fs-6 fw-normal">units</small></h2>
                <div class="mt-3 pt-3 border-top">
                    <span class="text-muted small">Real-time stock aggregation</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Recent Products -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold text-dark">Recent Arrivals</h5>
        <a asp-controller="Products" asp-action="Create" class="btn btn-primary btn-sm px-3">
            <i class="bi bi-plus-lg me-1"></i> New Product
        </a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th class="ps-4">Product Name</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in ViewBag.RecentProducts)
                    {
                        <tr>
                            <td class="ps-4 fw-medium text-dark">@product.Name</td>
                            <td><span class="badge bg-light text-secondary border">@product.Category?.Name</span></td>
                            <td class="fw-semibold">₹@product.Price.ToString("N2")</td>
                            <td>
                                @if (product.StockQuantity < 5)
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25">LOW STOCK</span>
                                }
                                else
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">IN STOCK</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id"
                                   class="btn btn-sm btn-light border">
                                    <i class="bi bi-arrow-right"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
