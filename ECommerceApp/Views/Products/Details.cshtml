@model ECommerceApp.Models.Product
@{
    ViewData["Title"] = "Product Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-info-circle me-2"></i>Product Details</h2>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Back to List
    </a>
</div>

<div class="card" style="max-width:650px">
    <div class="card-header bg-dark text-white">
        <h5 class="mb-0">@Model.Name</h5>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-4">Product ID</dt>
            <dd class="col-sm-8">#@Model.Id</dd>

            <dt class="col-sm-4">Description</dt>
            <dd class="col-sm-8">@(Model.Description ?? "—")</dd>

            <dt class="col-sm-4">Price</dt>
            <dd class="col-sm-8"><strong class="text-success fs-5">₹@Model.Price.ToString("N2")</strong></dd>

            <dt class="col-sm-4">Stock Quantity</dt>
            <dd class="col-sm-8">
                @if (Model.StockQuantity == 0)
                {
                    <span class="badge bg-danger fs-6">Out of Stock</span>
                }
                else
                {
                    <span class="badge bg-success fs-6">@Model.StockQuantity units</span>
                }
            </dd>

            <dt class="col-sm-4">Category</dt>
            <dd class="col-sm-8"><span class="badge bg-primary">@Model.Category?.Name</span></dd>

            <dt class="col-sm-4">Image URL</dt>
            <dd class="col-sm-8">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <a href="@Model.ImageUrl" target="_blank" class="text-truncate d-block">@Model.ImageUrl</a>
                }
                else
                {
                    <span class="text-muted">—</span>
                }
            </dd>

            <dt class="col-sm-4">Added On</dt>
            <dd class="col-sm-8">@Model.CreatedDate.ToString("dd MMMM yyyy")</dd>
        </dl>
    </div>
    <div class="card-footer">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
            <i class="bi bi-pencil me-1"></i>Edit
        </a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger ms-2">
            <i class="bi bi-trash me-1"></i>Delete
        </a>
    </div>
</div>
