@model ECommerceApp.Models.Product
@{
    ViewData["Title"] = "Product Details";
}

<div class="row align-items-center mb-5 fade-in">
    <div class="col">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-action="Index">Inventory</a></li>
                <li class="breadcrumb-item active">Product Specifications</li>
            </ol>
        </nav>
        <h2 class="display-6 fw-bold mb-0">@Model.Name</h2>
    </div>
    <div class="col-auto">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Return to List
        </a>
    </div>
</div>

<div class="row g-4 fade-in">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold">Primary Information</h5>
            </div>
            <div class="card-body p-4">
                <div class="row mb-4">
                    <div class="col-sm-4 text-muted small text-uppercase fw-bold">Description</div>
                    <div class="col-sm-8 text-dark fs-5">@(Model.Description ?? "No description available for this product.")</div>
                </div>
                <hr class="opacity-10" />
                <div class="row mb-4">
                    <div class="col-sm-4 text-muted small text-uppercase fw-bold">Categorization</div>
                    <div class="col-sm-8">
                        <span class="badge bg-primary px-3 py-2">@Model.Category?.Name</span>
                    </div>
                </div>
                <hr class="opacity-10" />
                <div class="row mb-4">
                    <div class="col-sm-4 text-muted small text-uppercase fw-bold">Inventory Status</div>
                    <div class="col-sm-8">
                        @if (Model.StockQuantity == 0)
                        {
                            <span class="text-danger fw-bold"><i class="bi bi-x-circle-fill me-2"></i>OUT OF STOCK</span>
                        }
                        else
                        {
                            <span class="text-success fw-bold"><i class="bi bi-check-circle-fill me-2"></i>@Model.StockQuantity Units Available</span>
                        }
                    </div>
                </div>
                <hr class="opacity-10" />
                <div class="row">
                    <div class="col-sm-4 text-muted small text-uppercase fw-bold">Logging Details</div>
                    <div class="col-sm-8 text-muted small">Registered in system on @Model.CreatedDate.ToString("dd MMMM yyyy, HH:mm")</div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm bg-primary text-white mb-4">
            <div class="card-body p-4 text-center">
                <div class="small fw-semibold text-uppercase opacity-75 mb-2">Market Price Per Unit</div>
                <div class="display-4 fw-bold mb-0">₹@Model.Price.ToString("N0")<small class="fs-4">.00</small></div>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-3">Management Actions</h6>
                <div class="d-grid gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning fw-bold text-dark">
                        <i class="bi bi-pencil-square me-2"></i> Edit Product
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger shadow-none">
                        <i class="bi bi-trash3 me-2"></i> Remove from Database
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
