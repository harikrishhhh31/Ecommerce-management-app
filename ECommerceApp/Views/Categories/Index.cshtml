@model IEnumerable<ECommerceApp.Models.Category>
@{
    ViewData["Title"] = "Categories";
}

<div class="row align-items-center mb-5 fade-in">
    <div class="col">
        <h2 class="display-6 fw-bold mb-0">Categories</h2>
        <p class="text-muted mb-0">Organize your product catalog into groupings.</p>
    </div>
    <div class="col-auto">
        <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2">
            <i class="bi bi-tag-fill fs-5"></i>
            <span>Add New Category</span>
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm overflow-hidden">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Category Name</th>
                        <th>Description</th>
                        <th>Product Count</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-dark">
                                @item.Name
                            </td>
                            <td class="text-muted">
                                @(item.Description ?? "No description provided")
                            </td>
                            <td>
                                <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 px-3">
                                    @item.Products.Count Products
                                </span>
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group shadow-sm rounded-3 overflow-hidden">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-white border-end" title="View">
                                        <i class="bi bi-info-circle-fill text-info"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-white border-end" title="Edit">
                                        <i class="bi bi-pencil-square text-warning"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-white" title="Remove">
                                        <i class="bi bi-trash3-fill text-danger"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<p class="text-muted mt-2 small">Total: @Model.Count() categorie(s)</p>
